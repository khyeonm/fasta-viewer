{
  "name": "fasta-viewer",
  "version": "1.6.0",
  "description": "Sequence viewer with colored nucleotides, sequence statistics, and GC content calculation",
  "extensions": [
    "fasta",
    "fa",
    "fasta.gz",
    "fa.gz"
  ],
  "entry": "index.js",
  "style": "style.css",
  "data_source": {
    "type": "text",
    "row_count": "wc -l < '{file}'",
    "metadata": "head -1 '{file}'",
    "rows": "sed -n '{start},{end}p' '{file}'",
    "col_headers": [],
    "meta_parse": "none",
    "allow_nonzero_exit": false,
    "fallback": [
      {
        "type": "docker",
        "image": "ubuntu:22.04",
        "row_count": "wc -l < '{file}'",
        "metadata": "head -1 '{file}'",
        "rows": "sed -n '{start},{end}p' '{file}'",
        "col_headers": [],
        "meta_parse": "none",
        "allow_nonzero_exit": false
      }
    ]
  }
}
